+		ix->n = n;
+		if (n >= CHILD_INDEX_MIN && n > ix->cap)
+		{
+			ix->child = fz_realloc_array(ctx, ix->child, n, fz_html_box *);
+			ix->pmax1 = fz_realloc_array(ctx, ix->pmax1, n, float);
+			ix->smin0 = fz_realloc_array(ctx, ix->smin0, n, float);
+			ix->cap = n;
+		}
+	}
